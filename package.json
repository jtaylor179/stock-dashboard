{
  "name": "stock-dashboard",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -ws",
    "clean": "npm run clean -ws"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}